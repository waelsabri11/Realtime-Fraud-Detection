# Copy to .env. Nothing here is a real secret; these are local-dev defaults only.
IEEE_DATA_DIR=~/Projects/ieee-fraud-detection
WORK_DIR=./work
DATABASE_URL=postgresql+psycopg://fraud:fraud@localhost:5432/fraud
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP=localhost:19092
MLFLOW_TRACKING_URI=http://localhost:5001
MODEL_NAME=fraud-lgbm
MODEL_VERSION=champion
LABEL_DELAY_DAYS=7

# Alert receiver (only used with the compose "monitoring" profile). Dry-run by default: issue bodies
# are written to ./work/issues. To file real issues: ALERT_DRY_RUN=false plus a token with
# "issues: write" on the repository. Never commit a real token.
ALERT_DRY_RUN=true
# GITHUB_REPOSITORY=owner/repo
# GITHUB_TOKEN=
